---
import SeoHead from "../components/seo/SeoHead.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import LiquidGlassFilter from "../components/ui/LiquidGlassFilter.astro";
import Nav from "../components/layout/Nav.astro";
import { defaultLanguage, type Language } from "../i18n/config";
import { content, type PortfolioContent } from "../data/content";
import { buildPersonJsonLd, buildWebsiteJsonLd } from "../lib/seo";
import "../styles/global.css";

interface Props {
  language?: Language;
}

const { language = defaultLanguage } = Astro.props;
const translations: PortfolioContent = content[language];
const siteUrl = Astro.site ?? Astro.url.origin;
const structuredData = [
  buildPersonJsonLd(translations, language, siteUrl),
  buildWebsiteJsonLd(translations, language, siteUrl),
];
---

<!doctype html>
<html lang={language} data-lang={language} class="motion-loading">
  <head>
    <SeoHead
      title={translations.meta.title}
      description={translations.meta.description}
      language={language}
      ogLocale={translations.meta.ogLocale}
    />
    <StructuredData data={structuredData} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
    />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("eric-mancebo-portfolio-theme");
          var theme = stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          document.documentElement.setAttribute("data-theme", theme);

          var storedLang = localStorage.getItem("eric-mancebo-portfolio-language");
          var lang =
            storedLang === "es" || storedLang === "en"
              ? storedLang
              : (navigator.language || "es").slice(0, 2).toLowerCase() === "en"
                ? "en"
                : "es";
          document.documentElement.setAttribute("lang", lang);
          document.documentElement.setAttribute("data-lang", lang);
        } catch (e) {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-i18n="es">Saltar al contenido</a>
    <a class="skip-link" href="#main-content" data-i18n="en">Skip to content</a>

    <LiquidGlassFilter />
    <Nav translations={translations} />

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <script>
      import { initTheme } from "../scripts/theme";
      import { initLanguage } from "../scripts/i18n";
      import { initMotion } from "../scripts/motion";

      initTheme();
      initLanguage();
      initMotion();
    </script>
  </body>
</html>
