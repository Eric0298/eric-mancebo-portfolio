---
import { content } from "../../data/content";
const es = content.es;
const en = content.en;
const items = es.links.items.map((_, i) => i);
---

<section id="links" class="section links">
  <div class="page-shell">
    <h2 class="section-title" data-motion="title">
      <span data-i18n="es">{es.links.title}</span>
      <span data-i18n="en">{en.links.title}</span>
    </h2>

    <div class="links__grid">
      <a class="links__email display" href={`mailto:${es.links.email}`}>{es.links.email}</a>
      <a class="links__phone display" href={es.links.phoneHref}>{es.links.phone}</a>

      <ul class="links__list" role="list">
        {items.map((i) => {
          const esItem = es.links.items[i];
          const enItem = en.links.items[i];
          const external = esItem.href.startsWith("http");
          return (
            <li>
              <a
                class="links__row"
                href={esItem.href}
                {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                data-motion="row"
              >
                <span class="links__label display">
                  <span data-i18n="es">{esItem.label}</span>
                  <span data-i18n="en">{enItem.label}</span>
                </span>
                <span class="links__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <p class="links__footer mono">
      <span data-i18n="es">{es.links.footer}</span>
      <span data-i18n="en">{en.links.footer}</span>
    </p>
  </div>
</section>

<style>
  .links__grid {
    display: grid;
    gap: var(--space-6);
    margin-block-end: var(--space-8);
  }

  .links__email,
  .links__phone {
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--ink);
    max-inline-size: max-content;
    transition: text-shadow var(--dur-med) var(--ease-out);
  }

  .links__email:hover,
  .links__phone:hover {
    text-shadow: 0 0 24px var(--glow), 0 0 60px var(--glow-soft);
  }

  .links__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .links__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
    padding-inline: var(--space-4);
    background: var(--card-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    color: var(--ink);
    transition: transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .links__row:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(7, 27, 61, 0.14);
  }

  .links__label {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .links__arrow {
    display: inline-block;
    transition: transform var(--dur-med) var(--ease-out);
    color: var(--ink-muted);
  }

  .links__row:hover .links__arrow {
    transform: translateX(6px);
    color: var(--ink);
  }

  .links__footer {
    color: var(--ink-faint);
    padding-block-start: var(--space-6);
  }
</style>
