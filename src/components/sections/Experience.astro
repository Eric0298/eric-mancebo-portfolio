---
import { content } from "../../data/content";
const es = content.es;
const en = content.en;
const rows = es.experience.items.map((_, i) => i);
---

<section id="experience" class="section experience">
  <div class="page-shell">
    <div class="section-head">
      <span class="eyebrow">
        <span data-i18n="es">{es.experience.eyebrow}</span>
        <span data-i18n="en">{en.experience.eyebrow}</span>
      </span>
    </div>

    <ul class="experience__list" role="list">
      {rows.map((i) => {
        const esItem = es.experience.items[i];
        const enItem = en.experience.items[i];
        return (
          <li class="experience__row" data-motion="row">
            <span class="experience__period mono">
              <span data-i18n="es">{esItem.period}</span>
              <span data-i18n="en">{enItem.period}</span>
            </span>
            <span class="experience__role display">
              <span data-i18n="es">{esItem.role}</span>
              <span data-i18n="en">{enItem.role}</span>
            </span>
            <span class="experience__place">
              <span data-i18n="es">{esItem.place}</span>
              <span data-i18n="en">{enItem.place}</span>
            </span>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .experience__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }

  .experience__row {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    gap: var(--space-5);
    align-items: baseline;
  }

  .experience__period {
    color: var(--ink-muted);
  }

  .experience__role {
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .experience__place {
    color: var(--ink-faint);
    font-size: var(--step-0);
  }

  @media (max-width: 640px) {
    .experience__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
