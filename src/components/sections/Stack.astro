---

<section id="stack" class="section stack">
  <div class="page-shell">
    <h2 class="section-title" data-motion="title">
      <SectionTitleText text={es.stack.title} lang="es" />
      <SectionTitleText text={en.stack.title} lang="en" />
    </h2>

    <div class="stack__grid">
      {allItems.map((name) => (
        <div class="stack__cell liquid-glass" data-motion="float">
          <div class="stack__icon" aria-hidden="true">
            {iconPaths[name] ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={iconPaths[name]} />
              </svg>
            ) : (
              <span class="stack__glyph display">{name[0]}</span>
            )}
          </div>
          <span class="stack__name">{name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .stack__cell {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg) !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-4);
    color: var(--ink);
    will-change: transform;
    cursor: default;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .stack__cell:hover {
    transform: translateY(-4px) scale(1.03);
  }

  .stack__icon {
    inline-size: 2.4rem;
    block-size: 2.4rem;
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .stack__icon svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .stack__glyph {
    font-size: 1.9rem;
    font-weight: 400;
    letter-spacing: -0.05em;
  }

  .stack__name {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    text-align: center;
  }
</style>
