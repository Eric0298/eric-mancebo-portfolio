---
import { Icon } from "astro-icon/components";
import { content } from "../../data/content";
import SectionTitleText from "../SectionTitleText.astro";
const es = content.es;
const en = content.en;

const allItems = es.stack.groups.flatMap((group) => group.items);

// Map each stack item to its official brand icon from the simple-icons set.
// Java uses openjdk because simple-icons drops the Oracle-trademarked Java mark.
const iconNames: Record<string, string> = {
  Astro: "simple-icons:astro",
  React: "simple-icons:react",
  "Next.js": "simple-icons:nextdotjs",
  JavaScript: "simple-icons:javascript",
  TypeScript: "simple-icons:typescript",
  Tailwind: "simple-icons:tailwindcss",
  "Node.js": "simple-icons:nodedotjs",
  Python: "simple-icons:python",
  Java: "simple-icons:openjdk",
  PHP: "simple-icons:php",
  PostgreSQL: "simple-icons:postgresql",
  MySQL: "simple-icons:mysql",
  MongoDB: "simple-icons:mongodb",
  Cloudflare: "simple-icons:cloudflare",
  Git: "simple-icons:git",
  GitHub: "simple-icons:github",
  Vite: "simple-icons:vite",
  Docker: "simple-icons:docker",
};
---

<section id="stack" class="section stack">
  <div class="page-shell">
    <h2 class="section-title" data-motion="title">
      <SectionTitleText text={es.stack.title} lang="es" />
      <SectionTitleText text={en.stack.title} lang="en" />
    </h2>

    <div class="stack__grid">
      {allItems.map((name) => (
        <div class="stack__cell liquid-glass" data-motion="float">
          <div class="stack__icon" aria-hidden="true">
            {iconNames[name] ? (
              <Icon name={iconNames[name]} />
            ) : (
              <span class="stack__glyph display">{name[0]}</span>
            )}
          </div>
          <span class="stack__name">{name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .stack__cell {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg) !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-4);
    color: var(--ink);
    will-change: transform;
    cursor: default;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .stack__cell:hover {
    transform: translateY(-4px) scale(1.03);
  }

  .stack__icon {
    inline-size: 2.4rem;
    block-size: 2.4rem;
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .stack__icon :global(svg) {
    inline-size: 100%;
    block-size: 100%;
    fill: currentColor;
  }

  .stack__glyph {
    font-size: 1.9rem;
    font-weight: 400;
    letter-spacing: -0.05em;
  }

  .stack__name {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    text-align: center;
  }
</style>
