---
import { Icon } from "astro-icon/components";
import { content } from "../../data/content";
import SectionTitleText from "../SectionTitleText.astro";
const es = content.es;
const en = content.en;

const primaryItems = es.stack.primary.groups.flatMap((group) => group.items);
const aiItems = es.stack.aiAssisted.items;

// Map each stack item to its official brand icon from the simple-icons set.
// Java uses openjdk because simple-icons drops the Oracle-trademarked Java mark.
const iconNames: Record<string, string> = {
  JavaScript: "simple-icons:javascript",
  TypeScript: "simple-icons:typescript",
  HTML: "simple-icons:html5",
  CSS: "simple-icons:css3",
  Bootstrap: "simple-icons:bootstrap",
  "Tailwind CSS": "simple-icons:tailwindcss",
  Java: "simple-icons:openjdk",
  PHP: "simple-icons:php",
  Laravel: "simple-icons:laravel",
  "Node.js": "simple-icons:nodedotjs",
  MySQL: "simple-icons:mysql",
  PostgreSQL: "simple-icons:postgresql",
  MongoDB: "simple-icons:mongodb",
  Git: "simple-icons:git",
  GitHub: "simple-icons:github",
  Docker: "simple-icons:docker",
  Jenkins: "simple-icons:jenkins",
  "GitHub Actions": "simple-icons:githubactions",
  Vercel: "simple-icons:vercel",
  Railway: "simple-icons:railway",
  Cloudflare: "simple-icons:cloudflare",
  Python: "simple-icons:python",
  "C#": "simple-icons:csharp",
  "ASP.NET Core": "simple-icons:dotnet",
  ".NET": "simple-icons:dotnet",
  Vitest: "simple-icons:vitest",
  "Testing Library": "simple-icons:testinglibrary",
};
---

<section id="stack" class="section stack">
  <div class="page-shell">
    <h2 class="section-title" data-motion="title">
      <SectionTitleText text={es.stack.title} lang="es" />
      <SectionTitleText text={en.stack.title} lang="en" />
    </h2>

    <div class="stack__grid">
      {primaryItems.map((name) => (
        <div class="stack__cell liquid-glass" data-motion="float">
          <div class="stack__icon" aria-hidden="true">
            {iconNames[name] ? (
              <Icon name={iconNames[name]} />
            ) : (
              <span class="stack__glyph display">{name[0]}</span>
            )}
          </div>
          <span class="stack__name">{name}</span>
        </div>
      ))}
    </div>

    <div class="stack__ai">
      <h3 class="stack__ai-title mono">
        <span data-i18n="es">{es.stack.aiAssisted.title}</span>
        <span data-i18n="en">{en.stack.aiAssisted.title}</span>
      </h3>
      <p class="stack__ai-note">
        <span data-i18n="es">{es.stack.aiAssisted.note}</span>
        <span data-i18n="en">{en.stack.aiAssisted.note}</span>
      </p>
      <div class="stack__grid stack__grid--ai">
        {aiItems.map((name) => (
          <div class="stack__cell liquid-glass" data-motion="float">
            <div class="stack__icon" aria-hidden="true">
              {iconNames[name] ? (
                <Icon name={iconNames[name]} />
              ) : (
                <span class="stack__glyph display">{name[0]}</span>
              )}
            </div>
            <span class="stack__name">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .stack__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .stack__cell {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg) !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-4);
    color: var(--ink);
    will-change: transform;
    cursor: default;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .stack__cell:hover {
    transform: translateY(-4px) scale(1.03);
  }

  .stack__icon {
    inline-size: 2.4rem;
    block-size: 2.4rem;
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .stack__icon :global(svg) {
    inline-size: 100%;
    block-size: 100%;
    fill: currentColor;
  }

  .stack__glyph {
    font-size: 1.9rem;
    font-weight: 400;
    letter-spacing: -0.05em;
  }

  .stack__name {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    text-align: center;
  }

  .stack__ai {
    margin-block-start: var(--space-8);
  }

  .stack__ai-title {
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: clamp(0.8rem, 0.7rem + 0.3vw, 1rem);
  }

  .stack__ai-note {
    color: var(--ink-muted);
    font-size: var(--step-0);
    line-height: 1.5;
    max-inline-size: 60ch;
    margin-block-start: var(--space-3);
  }
</style>
