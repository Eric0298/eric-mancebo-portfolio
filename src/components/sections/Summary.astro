---
import { content } from "../../data/content";
import SectionTitleText from "../SectionTitleText.astro";
const es = content.es;
const en = content.en;
const blockCount = Math.min(es.about.blocks.length, en.about.blocks.length);
const indexes = Array.from({ length: blockCount }, (_, i) => i);
---

<section id="about" class="about" data-motion="about" data-block-count={blockCount}>
  <div class="about__pin">
    <div class="page-shell about__shell">
      <h2 class="section-title about__title" data-motion="title">
        <SectionTitleText text={es.about.title} lang="es" />
        <SectionTitleText text={en.about.title} lang="en" />
      </h2>

      <div class="about__viewport" role="list">
        {indexes.map((i) => (
          <article class="about__block" data-about-index={i} role="listitem">
            <p class="about__paragraph" data-i18n="es">
              {es.about.blocks[i].map((seg) =>
                typeof seg === "string" ? (
                  seg
                ) : (
                  <em class="about__accent">{seg.accent}</em>
                ),
              )}
            </p>
            <p class="about__paragraph" data-i18n="en">
              {en.about.blocks[i].map((seg) =>
                typeof seg === "string" ? (
                  seg
                ) : (
                  <em class="about__accent">{seg.accent}</em>
                ),
              )}
            </p>
          </article>
        ))}
      </div>

      <div class="about__progress" aria-hidden="true">
        {indexes.map((i) => (
          <span class="about__dot" data-dot-index={i}></span>
        ))}
      </div>

      <p class="about__hint mono" aria-hidden="true">
        <span data-i18n="es">{es.about.scrollHint}</span>
        <span data-i18n="en">{en.about.scrollHint}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding-block: 0;
  }

  .about__pin {
    min-block-size: 100vh;
    min-block-size: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-8);
  }

  .about__shell {
    inline-size: 100%;
  }

  .about__title {
    margin-block-end: var(--space-6);
  }

  .about__viewport {
    position: relative;
    inline-size: 100%;
  }

  .about__block {
    inline-size: 100%;
  }

  .about__paragraph {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.4rem, 0.95rem + 1.6vw, 2.4rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-inline-size: 44ch;
    margin-inline: auto;
    text-align: start;
    text-wrap: pretty;
  }

  .about__accent {
    font-style: normal;
    font-weight: 700;
    color: var(--ink-strong);
    letter-spacing: -0.02em;
  }

  .about__progress {
    display: none;
  }

  .about__hint {
    color: var(--ink-faint);
    margin-block-start: var(--space-6);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    text-align: center;
  }

  /* -----------------------------------------------------------------
   * Fallback (no JS OR prefers-reduced-motion): blocks stack vertically
   * and every paragraph stays readable.
   * ----------------------------------------------------------------- */
  .about:not(.about--enhanced) .about__block + .about__block {
    margin-block-start: var(--space-6);
  }

  .about:not(.about--enhanced) .about__hint,
  .about:not(.about--enhanced) .about__progress {
    display: none;
  }

  /* -----------------------------------------------------------------
   * Enhanced (JS + motion allowed): blocks stack on top of each other
   * inside a fixed-height viewport; JS scrubs opacity between them
   * with a full fade-out → hold → fade-in cadence so no two blocks are
   * legible at the same time.
   * ----------------------------------------------------------------- */
  .about.about--enhanced .about__viewport {
    block-size: min(54dvh, 32rem);
  }

  .about.about--enhanced .about__block {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    opacity: 0;
    will-change: opacity, transform;
  }

  .about.about--enhanced .about__block[data-about-index="0"] {
    opacity: 1;
  }

  .about.about--enhanced .about__progress {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-block-start: var(--space-6);
  }

  .about__dot {
    display: block;
    inline-size: 1.75rem;
    block-size: 2px;
    background: var(--border-strong);
    border-radius: 999px;
    transition:
      background-color var(--dur-med) var(--ease-out),
      inline-size var(--dur-med) var(--ease-out);
  }

  .about__dot--active {
    background: var(--ink);
    inline-size: 2.75rem;
  }

  @media (max-width: 640px) {
    .about.about--enhanced .about__viewport {
      block-size: min(62dvh, 28rem);
    }

    .about__paragraph {
      max-inline-size: 32ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* If reduced motion is preferred we do NOT enter enhanced mode via JS,
       so blocks fall back to the natural stacked layout defined above. */
    .about__hint,
    .about__progress {
      display: none;
    }
  }
</style>
