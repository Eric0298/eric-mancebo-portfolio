---
import { content } from "../../data/content";
const es = content.es;
const en = content.en;

function splitWords(text: string) {
  return text.split(/\s+/).filter(Boolean);
}
const esWords = splitWords(es.about.body);
const enWords = splitWords(en.about.body);
---

<section id="about" class="section summary">
  <div class="page-shell">
    <h2 class="section-title" data-motion="title">
      <span data-i18n="es">{es.about.title}</span>
      <span data-i18n="en">{en.about.title}</span>
    </h2>

    <p class="summary__body display" data-i18n="es" data-motion="words">
      <span class="words">
        {esWords.map((word) => (
          <span class="words__word">{word}</span>
        ))}
      </span>
    </p>
    <p class="summary__body display" data-i18n="en" data-motion="words">
      <span class="words">
        {enWords.map((word) => (
          <span class="words__word">{word}</span>
        ))}
      </span>
    </p>
  </div>
</section>

<style>
  .summary {
    padding-block: var(--space-10);
  }

  .summary__body {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.6rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
    text-transform: none;
    max-inline-size: 28ch;
    margin-inline: auto;
    text-align: start;
  }

  .summary__body .words__word {
    margin-inline-end: 0.28em;
  }
</style>
