---
import { content } from "../../data/content";
import SectionTitleText from "../SectionTitleText.astro";
const es = content.es;
const en = content.en;
const blockCount = Math.min(es.about.blocks.length, en.about.blocks.length);
const indexes = Array.from({ length: blockCount }, (_, i) => i);
---

<section id="about" class="section about">
  <div class="page-shell page-shell--wide about__shell">
    <h2 class="section-title about__title" data-motion="title">
      <SectionTitleText text={es.about.title} lang="es" />
      <SectionTitleText text={en.about.title} lang="en" />
    </h2>

    <div
      class="about__rail horizontal-rail"
      data-horizontal-rail
      id="about-rail"
      tabindex="0"
      role="region"
      aria-label="Presentación / About"
    >
      {indexes.map((i) => (
        <article class="about__block liquid-glass" data-rail-slide>
          <span class="about__index mono" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <p class="about__paragraph" data-i18n="es">
            {es.about.blocks[i].map((seg) =>
              typeof seg === "string" ? seg : <em class="about__accent">{seg.accent}</em>,
            )}
          </p>
          <p class="about__paragraph" data-i18n="en">
            {en.about.blocks[i].map((seg) =>
              typeof seg === "string" ? seg : <em class="about__accent">{seg.accent}</em>,
            )}
          </p>
        </article>
      ))}
    </div>

    <div class="rail-controls about__controls">
      <div class="rail-controls__buttons">
        <button class="rail-controls__button" type="button" data-rail-prev aria-controls="about-rail" aria-label="Anterior / Previous">
          <span aria-hidden="true">←</span>
        </button>
        <button class="rail-controls__button" type="button" data-rail-next aria-controls="about-rail" aria-label="Siguiente / Next">
          <span aria-hidden="true">→</span>
        </button>
      </div>
      <span class="rail-controls__status mono" data-rail-status aria-live="polite">1 / {blockCount}</span>
      <p class="rail-controls__hint mono" aria-hidden="true">
        <span data-i18n="es">Desliza horizontalmente</span>
        <span data-i18n="en">Swipe horizontally</span>
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    overflow: clip;
  }

  .about__shell {
    inline-size: 100%;
  }

  .about__title {
    margin-block-end: var(--space-6);
  }

  .about__rail {
    --rail-gap: clamp(0.9rem, 2vw, 1.5rem);
    --rail-item-size: min(78vw, 48rem);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--rail-item-size);
    gap: var(--rail-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: inline mandatory;
    scroll-padding-inline: 1px;
    overscroll-behavior-inline: contain;
    touch-action: pan-x pan-y pinch-zoom;
    -webkit-overflow-scrolling: touch;
    padding: 1px var(--page-gutter);
    margin-inline: calc(-1 * var(--page-gutter));
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
    cursor: grab;
  }

  .about__rail.is-dragging {
    cursor: grabbing;
    user-select: none;
    scroll-snap-type: none;
  }

  .about__block {
    min-block-size: clamp(22rem, 52dvh, 31rem);
    border-radius: var(--radius-xl) !important;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: grid;
    grid-template-rows: auto 1fr;
    align-items: center;
    gap: var(--space-5);
    padding: clamp(1.4rem, 4vw, 3.5rem);
    contain: layout paint style;
  }

  .about__index {
    color: var(--ink-faint);
    letter-spacing: 0.12em;
    align-self: start;
  }

  .about__paragraph {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.25rem, 0.95rem + 1.15vw, 2.15rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-inline-size: 42ch;
    text-align: start;
    text-wrap: pretty;
  }

  .about__accent {
    font-style: normal;
    font-weight: 700;
    color: var(--ink-strong);
    letter-spacing: -0.02em;
  }

  .about__controls {
    margin-block-start: var(--space-5);
  }

  @media (max-width: 640px) {
    .about__rail {
      --rail-item-size: calc(100% - 2.4rem);
      scrollbar-width: none;
    }

    .about__rail::-webkit-scrollbar {
      display: none;
    }

    .about__block {
      min-block-size: min(66dvh, 30rem);
      padding: var(--space-5);
      border-radius: var(--radius-lg) !important;
    }

    .about__paragraph {
      font-size: clamp(1.08rem, 0.9rem + 1vw, 1.35rem);
      line-height: 1.5;
      max-inline-size: none;
    }
  }

  @media (max-height: 620px) {
    .about__block {
      min-block-size: 20rem;
    }
  }
</style>
