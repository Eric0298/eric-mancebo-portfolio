---
import { content } from "../../data/content";
const es = content.es;
const en = content.en;

/**
 * Row-level marquee content.
 * Each row duplicates its word list once so the CSS animation can loop
 * seamlessly by translating -50% of its own width.
 */
function buildRow(words: string[]) {
  const base = [...words, ...words, ...words, ...words];
  return [...base, ...base]; // duplicated for the -50% loop
}

const esRows = es.header.marqueeRows.map(buildRow);
const enRows = en.header.marqueeRows.map(buildRow);

const halfLen = (row: string[]) => row.length / 2;
---

<section id="top" class="hero">
  <div class="hero__marquees" aria-hidden="true">
    {
      [0, 1, 2].map((idx) => {
        const rowClass = ["hero__row--top", "hero__row--mid", "hero__row--bot"][idx];
        const trackAltClass = ["hero__row-track--top-alt", "", "hero__row-track--bot-alt"][idx];
        const showClip = idx !== 1;

        return (
          <div class={`hero__row ${rowClass}`}>
            <div class="hero__row-hit" />

            <div class="hero__row-base">
              <div class="hero__row-track" data-i18n="es">
                {esRows[idx].map((w, i) => (
                  <span class="hero__word display" aria-hidden={i >= halfLen(esRows[idx]) ? "true" : undefined}>
                    {w}
                  </span>
                ))}
              </div>
              <div class="hero__row-track" data-i18n="en">
                {enRows[idx].map((w, i) => (
                  <span class="hero__word display" aria-hidden={i >= halfLen(enRows[idx]) ? "true" : undefined}>
                    {w}
                  </span>
                ))}
              </div>
            </div>

            {showClip && (
              <div class="hero__row-clip">
                <div class={`hero__row-track ${trackAltClass}`} data-i18n="es">
                  {esRows[idx].map((w) => (
                    <span class="hero__word display">{w}</span>
                  ))}
                </div>
                <div class={`hero__row-track ${trackAltClass}`} data-i18n="en">
                  {enRows[idx].map((w) => (
                    <span class="hero__word display">{w}</span>
                  ))}
                </div>

                {idx === 0 && (
                  <>
                    <span
                      class="hero__row-silhouette-glitch hero__row-silhouette-glitch--a"
                      aria-hidden="true"
                    />
                    <span
                      class="hero__row-silhouette-glitch hero__row-silhouette-glitch--b"
                      aria-hidden="true"
                    />
                  </>
                )}
              </div>
            )}
          </div>
        );
      })
    }
  </div>

  <div class="hero__stage">
    <figure class="hero__photo" data-motion="portrait">
      <div class="hero__photo-inner">
        <img
          class="hero__photo-img"
          src="/heroImagen.png"
          alt={es.portrait.alt}
          width="600"
          height="800"
          loading="eager"
          decoding="async"
        />
        <span class="hero__photo-glitch hero__photo-glitch--a" aria-hidden="true"></span>
        <span class="hero__photo-glitch hero__photo-glitch--b" aria-hidden="true"></span>
        <span class="hero__photo-figure hero__photo-figure--a" aria-hidden="true"></span>
        <span class="hero__photo-figure hero__photo-figure--b" aria-hidden="true"></span>
      </div>
    </figure>
  </div>

  <div class="hero__foot">
    <div class="hero__meta-block" data-motion="rise" data-delay="0.6">
      <p class="hero__meta mono">
        <span>{es.header.locationLine}</span>
        <span class="hero__meta-sep" aria-hidden="true">·</span>
        <span data-clock aria-live="polite">--:--:--</span>
      </p>
      <p class="hero__meta mono">
        <span data-i18n="es">{es.header.role}</span>
        <span data-i18n="en">{en.header.role}</span>
      </p>
    </div>

    <a class="link-cta hero__cta" href="#links" data-motion="rise" data-delay="0.75">
      <span class="hero__cta-dot" aria-hidden="true"></span>
      <span data-i18n="es">{es.header.ctaLabel}</span>
      <span data-i18n="en">{en.header.ctaLabel}</span>
    </a>
  </div>
</section>

<style>
  .hero {
    /* Photo bounding box — drives clip-path of overlays */
    --photo-w: clamp(16rem, 28vw, 26rem);
    --photo-h: calc(var(--photo-w) * 4 / 3);
    --photo-cy: 52%;
    --photo-inset-x: calc(50% - var(--photo-w) / 2);
    --photo-inset-top: calc(var(--photo-cy) - var(--photo-h) / 2);
    --photo-inset-bottom: calc(100% - var(--photo-cy) - var(--photo-h) / 2);

    /* Row Y coords are tied to the photo box so rows 1 and 3
     * always cross the top and bottom bands of the image, regardless
     * of viewport size or aspect ratio. */
    --row-top-y: calc(var(--photo-cy) - var(--photo-h) * 0.36);
    --row-mid-y: var(--photo-cy);
    --row-bot-y: calc(var(--photo-cy) + var(--photo-h) * 0.36);

    --row-fs: clamp(3.25rem, 2rem + 8vw, 10rem);
    --hit-h: calc(var(--row-fs) * 0.72);

    --marquee-dur: 58s;

    position: relative;
    min-block-size: 100dvh;
    padding-block-start: 6rem;
    padding-block-end: var(--space-6);
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: clip;
    isolation: isolate;
  }

  /* ---------- Marquees layer ---------- */

  .hero__marquees {
    /*
     * Intentionally no z-index here — that would create a stacking context
     * and trap the top/bottom clip clones (z:3) below .hero__stage (z:2),
     * breaking the "overlay above the photo" behaviour.
     */
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__row {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__row-hit {
    position: absolute;
    inset-inline: 0;
    block-size: var(--hit-h);
    transform: translateY(-50%);
    pointer-events: auto;
    cursor: default;
  }

  .hero__row--top .hero__row-hit { inset-block-start: var(--row-top-y); }
  .hero__row--mid .hero__row-hit { inset-block-start: var(--row-mid-y); }
  .hero__row--bot .hero__row-hit { inset-block-start: var(--row-bot-y); }

  .hero__row-base,
  .hero__row-clip {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__row-clip {
    clip-path: inset(
      var(--photo-inset-top)
      var(--photo-inset-x)
      var(--photo-inset-bottom)
      var(--photo-inset-x)
    );
    -webkit-clip-path: inset(
      var(--photo-inset-top)
      var(--photo-inset-x)
      var(--photo-inset-bottom)
      var(--photo-inset-x)
    );
    z-index: 3;
  }

  .hero__row-base { z-index: 1; }

  /* Silhouette pin for row 1 clip only — draws the HeroSinFondo cutout on
   * top of the row 1 tracks so the letters visually pass BEHIND the body.
   * Lives inside the row-clip's own stacking context, so it doesn't need
   * to escape the photo's context. Photo body pixels underneath match
   * the silhouette pixels here, so the transition is seamless. */
  .hero__row--top .hero__row-clip::after {
    content: "";
    position: absolute;
    inset-block-start: var(--photo-inset-top);
    inset-inline-start: var(--photo-inset-x);
    inline-size: var(--photo-w);
    block-size: var(--photo-h);
    background-image: url("/HeroSinFondo.png");
    background-size: cover;
    background-position: center 25%;
    background-repeat: no-repeat;
    filter: grayscale(1) contrast(1.04);
    pointer-events: none;
  }

  /* When the photo is hovered, the pin itself wobbles just like the
   * base image — that way the intermediate silhouette layer inherits the
   * bg-photo micro-shake instead of standing still. */
  .hero:has(.hero__photo:hover) .hero__row--top .hero__row-clip::after,
  .hero:has(.hero__photo:focus-within) .hero__row--top .hero__row-clip::after {
    animation: glitch-base 1.4s steps(1, end) infinite;
  }

  /* Silhouette-shaped glitch bands, above the pin. Same clip-path pattern
   * as the bg-photo glitch and slightly tinted so the flashes read as
   * chromatic ghost cuts on top of the body, matching what happens on
   * the background at the same instant. */
  /* Silhouette glitch bands use mask-image so we can paint an explicit
   * colored gradient onto the body shape. Grayscale sources ignore
   * hue-rotate — this way each band carries a real tint. */
  .hero__row-silhouette-glitch {
    position: absolute;
    inset-block-start: var(--photo-inset-top);
    inset-inline-start: var(--photo-inset-x);
    inline-size: var(--photo-w);
    block-size: var(--photo-h);
    -webkit-mask-image: url("/HeroSinFondo.png");
            mask-image: url("/HeroSinFondo.png");
    -webkit-mask-size: cover;
            mask-size: cover;
    -webkit-mask-position: center 25%;
            mask-position: center 25%;
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
    z-index: 2;
  }

  .hero__row-silhouette-glitch--a {
    background: linear-gradient(
      180deg,
      #f4f5f8 0%,
      #cfd3da 45%,
      #ebedf1 100%
    );
  }
  .hero__row-silhouette-glitch--b {
    background: linear-gradient(
      180deg,
      #b498e0 0%,
      #7a58c8 40%,
      #a888d8 70%,
      #6d4fb3 100%
    );
  }

  .hero:has(.hero__photo:hover) .hero__row-silhouette-glitch--a,
  .hero:has(.hero__photo:focus-within) .hero__row-silhouette-glitch--a {
    animation: silhouette-glitch-a 0.72s steps(1, end) infinite;
  }
  .hero:has(.hero__photo:hover) .hero__row-silhouette-glitch--b,
  .hero:has(.hero__photo:focus-within) .hero__row-silhouette-glitch--b {
    animation: silhouette-glitch-b 0.94s steps(1, end) infinite;
  }

  /* Higher opacity peaks than the bg version — the silhouette needs
   * clearly visible cuts because it's a static grayscale surface. */
  @keyframes silhouette-glitch-a {
    0%, 100%   { opacity: 0; clip-path: inset(0 0 100% 0); transform: translate3d(0, 0, 0); }
    6%, 9%     { opacity: 0.95; clip-path: inset(10% 0 82% 0); transform: translate3d(-3px, 0, 0); }
    18%, 20%   { opacity: 0.8; clip-path: inset(32% 0 60% 0); transform: translate3d(2px, 0, 0); }
    30%        { opacity: 0; }
    44%, 47%   { opacity: 0.9; clip-path: inset(48% 0 46% 0); transform: translate3d(-2px, 0, 0); }
    58%, 61%   { opacity: 0.75; clip-path: inset(62% 0 32% 0); transform: translate3d(3px, 0, 0); }
    72%        { opacity: 0; }
    84%, 87%   { opacity: 0.85; clip-path: inset(80% 0 14% 0); transform: translate3d(-2px, 0, 0); }
    94%        { opacity: 0; }
  }

  @keyframes silhouette-glitch-b {
    0%, 100%   { opacity: 0; clip-path: inset(0 0 100% 0); transform: translate3d(0, 0, 0); }
    12%, 15%   { opacity: 0.75; clip-path: inset(20% 0 74% 0); transform: translate3d(3px, 0, 0); }
    28%        { opacity: 0; }
    40%, 43%   { opacity: 0.85; clip-path: inset(44% 0 50% 0); transform: translate3d(-3px, 0, 0); }
    56%, 59%   { opacity: 0.7; clip-path: inset(58% 0 36% 0); transform: translate3d(2px, 0, 0); }
    70%        { opacity: 0; }
    82%, 85%   { opacity: 0.8; clip-path: inset(74% 0 20% 0); transform: translate3d(-2px, 0, 0); }
    96%        { opacity: 0; }
  }

  /* Row tracks */
  .hero__row-track {
    position: absolute;
    inset-inline-start: 0;
    inline-size: max-content;
    display: flex;
    gap: 3rem;
    white-space: nowrap;
    color: var(--ink-strong);
    font-size: var(--row-fs);
    line-height: 0.86;
    letter-spacing: -0.035em;
    user-select: none;
    transform: translate3d(0, -50%, 0);
    will-change: transform;
    animation: hero-marquee var(--marquee-dur) linear infinite;
  }

  .hero__row--top .hero__row-track { inset-block-start: var(--row-top-y); }
  .hero__row--mid .hero__row-track {
    inset-block-start: var(--row-mid-y);
    animation-direction: reverse;
    animation-duration: calc(var(--marquee-dur) + 10s);
  }
  .hero__row--bot .hero__row-track {
    inset-block-start: var(--row-bot-y);
    animation-duration: calc(var(--marquee-dur) - 6s);
  }

  .hero__word {
    display: inline-block;
    padding-inline-end: 3rem;
    /* Liquid-glass varnish on each letter: a very subtle vertical depth
     * gradient + tiny chromatic aberration via layered drop-shadows.
     * The idea is the letter surface itself reads as glass, not a
     * highlight band moving across it. */
    color: transparent;
    background: linear-gradient(
      180deg,
      #1e1e22 0%,
      #0a0a0d 32%,
      #030305 55%,
      #0a0a0d 78%,
      #1c1c20 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0.6px 0 0 rgba(120, 170, 255, 0.16))
      drop-shadow(-0.6px 0 0 rgba(255, 165, 195, 0.14))
      drop-shadow(0 1px 0 rgba(255, 255, 255, 0.18))
      drop-shadow(0 2px 5px rgba(0, 0, 0, 0.28));
  }

  :global([data-theme="dark"]) .hero__word {
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #e6e6ea 32%,
      #f6f6f9 55%,
      #dcdce0 78%,
      #ffffff 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    filter:
      drop-shadow(0.6px 0 0 rgba(140, 190, 255, 0.28))
      drop-shadow(-0.6px 0 0 rgba(255, 170, 200, 0.24))
      drop-shadow(0 1px 0 rgba(255, 255, 255, 0.5))
      drop-shadow(0 2px 6px rgba(0, 0, 0, 0.55));
  }

  /* Dark mode — alternate every other word in the BASE tracks with the
   * silhouette's silver+purple palette so the marquee reads as a rhythm
   * of white vs chromed lavender. Only base tracks are targeted: the
   * top-alt / bot-alt clones keep their dedicated fills. */
  :global([data-theme="dark"])
    .hero__row-track:not(.hero__row-track--top-alt):not(.hero__row-track--bot-alt)
    > .hero__word:nth-child(even) {
    background: linear-gradient(
      180deg,
      #dcd0f0 0%,
      #a888d8 30%,
      #7a58c8 55%,
      #a888d8 78%,
      #dcd0f0 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    filter:
      drop-shadow(0.6px 0 0 rgba(200, 170, 255, 0.35))
      drop-shadow(-0.6px 0 0 rgba(255, 180, 220, 0.28))
      drop-shadow(0 1px 0 rgba(230, 210, 255, 0.5))
      drop-shadow(0 2px 8px rgba(0, 0, 0, 0.6));
  }

  /* Top overlay clone — translucent glass rendered inside the photo.
   * Overrides the base word varnish so the letters read as pale glass
   * against the darker portrait, keeping the "seen through frosted
   * image" feeling. */
  .hero__row-track--top-alt .hero__word {
    background:
      linear-gradient(
        118deg,
        transparent 38%,
        rgba(255, 255, 255, 0.35) 50%,
        transparent 62%
      ),
      linear-gradient(
        180deg,
        rgba(230, 232, 236, 0.72) 0%,
        rgba(190, 195, 205, 0.55) 40%,
        rgba(200, 205, 215, 0.55) 60%,
        rgba(230, 232, 236, 0.72) 100%
      );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.25));
  }

  /* Bottom overlay clone — silver-predominant varnish with the faintest
   * iridescent hints. The silver layer tiles horizontally so the letter
   * is ALWAYS filled regardless of the animation phase — animating just
   * the tile offset gives a slow shifting-highlight feel. The sheen
   * sweep on top is a wider no-repeat band that fades in and out. */
  .hero__row-track--bot-alt .hero__word {
    background:
      linear-gradient(
        118deg,
        transparent 34%,
        rgba(255, 255, 255, 0.85) 47%,
        rgba(255, 255, 255, 1) 50%,
        rgba(255, 255, 255, 0.85) 53%,
        transparent 66%
      ),
      linear-gradient(
        110deg,
        #d8dbe0 0%,
        #eef1f4 12%,
        #c4d0d8 25%,   /* very subtle cool */
        #e6e2e6 40%,
        #d8d2d6 55%,   /* very subtle warm */
        #eef1f4 70%,
        #c8ccd2 85%,
        #d8dbe0 100%
      );
    background-size: 260% 100%, 300% 100%;
    background-position: -130% 0, 0% 50%;
    background-repeat: no-repeat, repeat;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter:
      drop-shadow(0 1px 0 rgba(255, 255, 255, 0.5))
      drop-shadow(0 2px 6px rgba(0, 0, 0, 0.35));
    animation: hero-silver 14s linear infinite;
  }

  @keyframes hero-silver {
    0%   { background-position: -130% 0,    0% 50%; }
    50%  { background-position:  230% 0, -100% 50%; }
    100% { background-position:  230% 0, -200% 50%; }
  }

  /* Hover-pause synced base + clone via :has() on the row */
  .hero__row:has(.hero__row-hit:hover) .hero__row-track {
    animation-play-state: paused;
  }
  .hero__row-hit:focus-visible ~ .hero__row-base .hero__row-track,
  .hero__row-hit:focus-visible ~ .hero__row-clip .hero__row-track {
    animation-play-state: paused;
  }

  @keyframes hero-marquee {
    from { transform: translate3d(0, -50%, 0); }
    to   { transform: translate3d(-50%, -50%, 0); }
  }

  /* ---------- Photo layer ---------- */

  .hero__stage {
    /* Stage fills the whole hero so the photo can be positioned in the
     * same coord system used by the row-clip pseudo-elements (silhouette
     * pin), keeping them in perfect register. */
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .hero__photo {
    position: absolute;
    inset-block-start: calc(var(--photo-cy) - var(--photo-h) / 2);
    inset-inline-start: calc(50% - var(--photo-w) / 2);
    inline-size: var(--photo-w);
    block-size: var(--photo-h);
    will-change: transform;
    pointer-events: auto;
  }

  .hero__photo-inner {
    position: relative;
    inline-size: 100%;
    block-size: 100%;
    overflow: hidden;
    background: var(--bg-deep);
    box-shadow: 0 30px 80px rgba(7, 27, 61, 0.18);
    isolation: isolate;
  }

  :global([data-theme="dark"]) .hero__photo-inner {
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
  }

  .hero__photo-img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 25%;
    filter: grayscale(1) contrast(1.04);
    transform: translate3d(0, 0, 0);
    z-index: 1;
  }

  /* Background glitch — full B/W portrait shifted in bands */
  .hero__photo-glitch {
    position: absolute;
    inset: 0;
    background-image: url("/heroImagen.png");
    background-size: cover;
    background-position: center 25%;
    background-repeat: no-repeat;
    filter: grayscale(1) contrast(1.04);
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: screen;
    z-index: 2;
  }
  .hero__photo-glitch--a { z-index: 2; }
  .hero__photo-glitch--b { z-index: 3; }

  /* Silhouette glitch — silver/violet chrome, masked to the cutout PNG.
   * Same silver ramp used by the marquee bot-alt with extra magenta/purple
   * so it reads as "chromed figure" independent from the background glitch. */
  .hero__photo-figure {
    position: absolute;
    inset: 0;
    -webkit-mask-image: url("/HeroSinFondo.png");
            mask-image: url("/HeroSinFondo.png");
    -webkit-mask-size: cover;
            mask-size: cover;
    -webkit-mask-position: center 25%;
            mask-position: center 25%;
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    background: linear-gradient(
      110deg,
      #dcd7e6 0%,
      #b39ee6 10%,   /* lavender */
      #eef1f4 22%,
      #8c6ad4 34%,   /* purple */
      #dcd0e6 46%,
      #a988e0 58%,   /* violet */
      #eef1f4 70%,
      #7a58c8 82%,   /* deep purple */
      #d0d3e2 92%,
      #dcd7e6 100%
    );
    background-size: 240% 100%;
    background-position: 0% 50%;
    background-repeat: repeat;
    filter:
      drop-shadow(0 0 6px rgba(140, 106, 212, 0.35))
      drop-shadow(0 0 2px rgba(255, 255, 255, 0.45));
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
    z-index: 4;
  }
  .hero__photo-figure--a { z-index: 4; }
  .hero__photo-figure--b { z-index: 5; }

  .hero__photo:hover .hero__photo-img,
  .hero__photo:focus-within .hero__photo-img,
  .hero__photo:active .hero__photo-img {
    animation: glitch-base 1.4s steps(1, end) infinite;
  }
  .hero__photo:hover .hero__photo-glitch--a,
  .hero__photo:focus-within .hero__photo-glitch--a,
  .hero__photo:active .hero__photo-glitch--a {
    animation: glitch-a 0.72s steps(1, end) infinite;
  }
  .hero__photo:hover .hero__photo-glitch--b,
  .hero__photo:focus-within .hero__photo-glitch--b,
  .hero__photo:active .hero__photo-glitch--b {
    animation: glitch-b 0.94s steps(1, end) infinite;
  }

  .hero__photo:hover .hero__photo-figure--a,
  .hero__photo:focus-within .hero__photo-figure--a,
  .hero__photo:active .hero__photo-figure--a {
    animation:
      figure-a 0.66s steps(1, end) infinite,
      figure-chroma 6s linear infinite;
  }
  .hero__photo:hover .hero__photo-figure--b,
  .hero__photo:focus-within .hero__photo-figure--b,
  .hero__photo:active .hero__photo-figure--b {
    animation:
      figure-b 0.88s steps(1, end) infinite,
      figure-chroma 7.5s linear infinite reverse;
  }

  @keyframes figure-chroma {
    from { background-position:    0% 50%; }
    to   { background-position: -240% 50%; }
  }

  /* Sparkle-style glitch: many thin bands, tiny shifts, mostly-off frames.
   * Amplitude is 1-2px so the image barely wobbles — the feeling comes
   * from short bright flickers rather than a coarse shake. */
  @keyframes glitch-base {
    0%, 100%      { transform: translate3d(0, 0, 0); }
    22%, 24%      { transform: translate3d(-1px, 0, 0); }
    46%, 47%      { transform: translate3d(1px, 0, 0); }
    72%, 73%      { transform: translate3d(-1px, 0, 0); }
  }

  @keyframes glitch-a {
    0%, 100%   { opacity: 0; clip-path: inset(0 0 100% 0); transform: translate3d(0, 0, 0); }
