---
import { content } from "../../data/content";
const es = content.es;
const en = content.en;
---

<section id="top" class="hero">
  <div class="hero__stage">
    <h1 class="hero__display display" aria-label={es.header.name} data-motion="display">
      <span aria-hidden="true">E</span><span aria-hidden="true">R</span><span aria-hidden="true">I</span><span aria-hidden="true">C</span>
    </h1>

    <div class="hero__portrait" data-motion="portrait" aria-hidden="true">
      <div class="hero__portrait-frame">
        <span class="hero__portrait-label" data-i18n="es">Retrato</span>
        <span class="hero__portrait-label" data-i18n="en">Portrait</span>
      </div>
    </div>
  </div>

  <div class="hero__caption">
    <p class="hero__lead display" data-motion="rise" data-delay="0.5">
      <span data-i18n="es">Desarrollo web con criterio y precisión.</span>
      <span data-i18n="en">Web development with judgment and precision.</span>
    </p>
    <p class="hero__meta mono" data-motion="rise" data-delay="0.65">
      <span data-i18n="es">{es.header.role} · {es.header.location}</span>
      <span data-i18n="en">{en.header.role} · {en.header.location}</span>
    </p>
    <a class="cta hero__cta" href="#projects" data-motion="rise" data-delay="0.8">
      <span class="cta__dot"></span>
      <span data-i18n="es">Ver proyectos</span>
      <span data-i18n="en">See projects</span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-block-size: 100dvh;
    padding-block-start: 6.5rem;
    padding-block-end: var(--space-8);
    padding-inline: var(--page-gutter);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    overflow: hidden;
  }

  .hero__stage {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 100%;
    max-inline-size: 100rem;
    isolation: isolate;
  }

  .hero__display {
    font-size: var(--step-display);
    line-height: 0.82;
    color: var(--ink-strong);
    text-align: center;
    letter-spacing: -0.06em;
    display: flex;
    justify-content: center;
    align-items: center;
    inline-size: 100%;
    gap: clamp(0.5rem, 2vw, 3rem);
    user-select: none;
    text-shadow: 0 0 80px var(--glow-soft);
  }

  .hero__display > span {
    display: inline-block;
    will-change: transform, opacity;
  }

  .hero__portrait {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    aspect-ratio: 3 / 4;
    inline-size: clamp(14rem, 24vw, 22rem);
    will-change: transform;
  }

  .hero__portrait-frame {
    inline-size: 100%;
    block-size: 100%;
    background: var(--bg-subtle);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    display: grid;
    place-items: center;
    color: var(--ink-faint);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 30px 80px rgba(7, 27, 61, 0.18);
  }

  [data-theme="dark"] .hero__portrait-frame {
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .hero__caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-block-start: var(--space-6);
    text-align: center;
    max-inline-size: 34rem;
  }

  .hero__lead {
    font-size: clamp(1.2rem, 1rem + 1vw, 1.9rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .hero__meta {
    color: var(--ink-muted);
  }

  .hero__cta {
    margin-block-start: var(--space-3);
  }

  @media (max-width: 640px) {
    .hero {
      padding-block-start: 5rem;
    }
    .hero__display {
      gap: 0;
    }
    .hero__portrait {
      inline-size: clamp(11rem, 55vw, 18rem);
    }
  }
</style>
