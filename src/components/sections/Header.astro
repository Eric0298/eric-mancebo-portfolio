---
import { content } from "../../data/content";
const es = content.es;
const en = content.en;

// Long marquee sequence
const esMarquee = [...es.header.marqueeTerms, ...es.header.marqueeTerms, ...es.header.marqueeTerms];
const enMarquee = [...en.header.marqueeTerms, ...en.header.marqueeTerms, ...en.header.marqueeTerms];
---

<section id="top" class="hero">
  <div class="hero__marquee-row" data-motion="marquee" aria-hidden="true">
    <div class="marquee hero__marquee-track" data-i18n="es">
      {esMarquee.map((term) => <span class="hero__word display">{term}</span>)}
    </div>
    <div class="marquee hero__marquee-track" data-i18n="en">
      {enMarquee.map((term) => <span class="hero__word display">{term}</span>)}
    </div>
  </div>

  <div class="hero__stage">
    <div class="hero__portrait" data-motion="portrait" aria-hidden="true">
      <div class="hero__portrait-frame">
        <span class="hero__portrait-label" data-i18n="es">Retrato</span>
        <span class="hero__portrait-label" data-i18n="en">Portrait</span>
      </div>
    </div>
  </div>

  <div class="hero__foot">
    <div class="hero__meta-block" data-motion="rise" data-delay="0.6">
      <p class="hero__meta mono">
        <span>{es.header.locationLine}</span>
        <span class="hero__meta-sep" aria-hidden="true">·</span>
        <span data-clock aria-live="polite">--:--:--</span>
      </p>
      <p class="hero__meta mono">
        <span data-i18n="es">{es.header.role}</span>
        <span data-i18n="en">{en.header.role}</span>
      </p>
    </div>

    <a class="link-cta hero__cta" href="#links" data-motion="rise" data-delay="0.75">
      <span class="hero__cta-dot" aria-hidden="true"></span>
      <span data-i18n="es">{es.header.ctaLabel}</span>
      <span data-i18n="en">{en.header.ctaLabel}</span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-block-size: 100dvh;
    padding-block-start: 6rem;
    padding-block-end: var(--space-6);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-6);
    overflow: hidden;
  }

  .hero__marquee-row {
    position: absolute;
    inset-block-start: 42%;
    inset-inline-start: 0;
    inset-inline-end: 0;
    transform: translateY(-50%);
    z-index: 0;
    inline-size: 200%;
    max-inline-size: none;
    pointer-events: none;
  }

  .hero__marquee-track {
    font-size: clamp(4rem, 2rem + 12vw, 14rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    color: var(--ink-strong);
  }

  .hero__word {
    display: inline-block;
    padding-inline-end: 1.2rem;
  }

  .hero__stage {
    position: relative;
    display: grid;
    place-items: center;
    z-index: 1;
    padding-inline: var(--page-gutter);
  }

  .hero__portrait {
    z-index: 2;
    aspect-ratio: 3 / 4;
    inline-size: clamp(14rem, 24vw, 22rem);
    will-change: transform;
  }

  .hero__portrait-frame {
    inline-size: 100%;
    block-size: 100%;
    background: var(--bg-subtle);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    display: grid;
    place-items: center;
    color: var(--ink-faint);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 30px 80px rgba(7, 27, 61, 0.18);
  }

  [data-theme="dark"] .hero__portrait-frame {
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .hero__foot {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-5);
    padding-inline: var(--page-gutter);
  }

  .hero__meta-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .hero__meta {
    color: var(--ink-muted);
  }

  .hero__cta {
    margin-inline-start: auto;
  }

  @media (max-width: 640px) {
    .hero {
      padding-block-start: 5rem;
      gap: var(--space-4);
    }
    .hero__foot {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }
    .hero__cta {
      margin-inline-start: 0;
    }
    .hero__portrait {
      inline-size: clamp(11rem, 55vw, 18rem);
    }
  }
</style>
