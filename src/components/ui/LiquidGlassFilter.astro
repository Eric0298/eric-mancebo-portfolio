---
// Single SVG filter definition — subtle refractive distortion for glass surfaces.
// Include once at the root of the layout, then reference via `filter: url(#liquid-glass)`.
---

<svg aria-hidden="true" width="0" height="0" style="position:absolute">
  <defs>
    <filter id="liquid-glass" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.012 0.014"
        numOctaves="2"
        seed="7"
        result="noise"
      />
      <feDisplacementMap
        in="SourceGraphic"
        in2="noise"
        scale="6"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>
  </defs>
</svg>
